{
  "name": "moodle-mcp",
  "version": "0.1.0",
  "description": "MCP server that works a Moodle site through a real browser (Playwright), with domain tools",
  "author": "Falkenslab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/moodle-mcp.git"
  },
  "homepage": "https://github.com/falkenslab/moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/falkenslab/moodle-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "playwright",
    "lms"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "moodle-mcp": "dist/server.mjs"
  },
  "files": [
    "dist/server.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.mjs",
    "test:docker": "node scripts/in-docker.mjs npm test"
  },
  "dependencies": {
    "playwright-core": "^1.64.0"
  },
  "bundleDependencies": [
    "playwright-core"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@falkenslab/moodle-driver": "^0.4.0",
    "@falkenslab/pseudonym": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
